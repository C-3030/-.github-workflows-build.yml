<?xml version="1.0" encoding="utf-8"?>
<!-- 关注用户列表:切换每张卡片下方展示的最近作品类型 -->
<com.google.android.material.button.MaterialButtonToggleGroup xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toggle_works"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    app:singleSelection="true"
    app:selectionRequired="true">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_works_illust"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="@string/works_illust" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_works_novel"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="@string/works_novel" />
</com.google.android.material.button.MaterialButtonToggleGroup>
